SECRET_KEY=generar_un_valor_largo_y_unico_para_desarrollo

# Necesarias para que el cliente pueda validar licencias y enviar solicitudes.
# Usar solo la URL base del proyecto, sin /rest/v1.
NEXAR_LICENSES_VALIDATION_URL=https://tu-proyecto.supabase.co
NEXAR_LICENSES_SUPABASE_KEY=tu_anon_key_publica
NEXAR_LICENSES_TIMEOUT=12
NEXAR_LICENSES_CONNECT_TIMEOUT=3
NEXAR_LICENSES_READ_TIMEOUT=12
NEXAR_LICENSES_MAX_RETRIES=0
NEXAR_LICENSES_RETRY_BACKOFF=0.25
NEXAR_LICENSES_RETRY_STATUS_CODES=408,429,500,502,503,504
NEXAR_LICENSES_CACHE_FILE=license_cache.json
NEXAR_LICENSES_CACHE_DIR=
NEXAR_LICENSES_CACHE_TTL=3
NEXAR_LICENSES_OFFLINE_FALLBACK=true

# Aliases legacy conservados para instalaciones existentes.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica
SUPABASE_KEY=tu_anon_key_publica
NEXAR_CACHE_FILE=license_cache.json
NEXAR_CACHE_DAYS=3

LICENSE_PRODUCT=nexar-tienda
NEXAR_RUBRO=tienda
